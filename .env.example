# Flask Configuration
FLASK_ENV=development
[REDACTED_GENERIC_SECRET_1]=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///faceoffice.db

# Cloudinary Cloud Storage (for visitor photos)
# Sign up at https://cloudinary.com (free tier available)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_[REDACTED_GENERIC_SECRET_2]=your-api-secret

# Firebase Cloud Messaging (for push notifications)
# Sign up at https://firebase.google.com
# Download service account key from Firebase Console > Project Settings > Service Accounts
# Save as firebase-key.json in project root
FIREBASE_KEY_PATH=firebase-key.json

# Email Notifications (using Gmail SMTP)
# Enable 2FA on Gmail and create App Password at https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=[REDACTED_EMAIL_ADDRESS_2]
MAIL_[REDACTED_GENERIC_PASSWORD_5]=your-16-char-app-password
MAIL_DEFAULT_SENDER=[REDACTED_EMAIL_ADDRESS_2]

# Admin Settings
ADMIN_[REDACTED_GENERIC_PASSWORD_1]=admin-password-change-in-production

# App Configuration
APP_URL=http://localhost:5000
