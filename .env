FLASK_ENV=development
SECRET_KEY=your_flask-env-secret-key

# Database (SQLite)
DATABASE_URL=sqlite:///faceoffice.db

# Gmail SMTP (Email Configuration)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=Your-email@gmail.com
MAIL_PASSWORD=abcdefghijklmnop

# Cloudinary (Photo Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary-name
CLOUDINARY_API_KEY=your_cloudinary-key
CLOUDINARY_API_SECRET=your_cloudinary-secret-key

# Firebase Realtime Database
FIREBASE_KEY_PATH=firebase-key.json
FIREBASE_DB_URL=your_firebase-db-url

# App URL
APP_URL=http://localhost:5000
